# Copia este archivo a .env.local y ajusta los valores.

# Conexión a PostgreSQL con PostGIS (Neon, Supabase, local...). Obligatoria para migraciones e ingesta.
DATABASE_URL=postgres://usuario:clave@localhost:5432/aparcat

# Nivel de registro: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# Servicio del Ayuntamiento del que se leen los datos de tráfico.
VALENCIA_TRAFFIC_BASE_URL=https://geoportal.valencia.es/server/rest/services/OPENDATA/Trafico/MapServer

# Identificación de la aplicación ante el Ayuntamiento.
INGEST_USER_AGENT=aparcat/0.1 (+https://github.com/vsornosa1/parkflow)

# Tiempo máximo de espera por petición, en milisegundos.
INGEST_TIMEOUT_MS=15000

# Clave pública de MapTiler, restringida por origen en su panel.
# Sin esta clave el mapa muestra un fondo neutro con las capas de datos.
NEXT_PUBLIC_MAPTILER_KEY=
# Estilo de MapTiler: streets-v4, dataviz-v2, basic-v2...
NEXT_PUBLIC_MAPTILER_STYLE=streets-v4

# Sal con la que se anonimiza el identificador de dispositivo de los reportes.
REPORT_SALT=aparcat-dev-salt

# Correo de contacto que aparece en las páginas legales.
NEXT_PUBLIC_CONTACT_EMAIL=privacidad@aparcat.example
